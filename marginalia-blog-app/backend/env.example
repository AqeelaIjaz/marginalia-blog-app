# Rename this file to ".env" and fill in your real values
# Never commit the real .env file to GitHub — it's already in .gitignore

PORT=5001
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=any_long_random_secret_string_here

# The URL where your FRONTEND is served (used to build the password reset link)
CLIENT_URL=http://127.0.0.1:5500/frontend

# Gmail address that will SEND password reset emails, and its App Password
# (See README.md "Setting up email" section for how to generate an App Password)
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_character_app_password
